[Unit]
Description=WATTx Merged Mining Pool
After=network.target

[Service]
Type=simple
User=nuts
WorkingDirectory=/opt/wattx-pool/backend
ExecStart=/usr/bin/node merged-pool.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wattx-pool

# RPC credentials — edit these
Environment=WATTX_RPC_HOST=127.0.0.1
Environment=WATTX_RPC_PORT=2337
Environment=WATTX_RPC_USER=wattxrpc
Environment=WATTX_RPC_PASS=v4AZR3AmHHbrMkRfhXlkWH6MI1bFeHwV

# XMR merged mining
Environment=XMR_RPC_HOST=xmr.monerodice.pro
Environment=XMR_RPC_PORT=18089
Environment=XMR_POOL_WALLET=4AsjKppNcHfJPekAPKVMsecyVT1v35MVn4N6dsXYSVTZHWsmC66u3sDT5NYavm5udMXHf32Ntb4N2bJqhnN4Gfq2GKZYmMK

